# Copy this file to .env.local and fill in the values for local development.
# NEVER commit .env.local (it is gitignored).

# Base URL of the aac-proxy Cloudflare Worker.
# For local development, run the proxy with `wrangler dev` (defaults to port 8787).
# For production, set this to your deployed worker URL.
VITE_PROXY_URL=http://localhost:8787
